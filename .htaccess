# 1. Canonical URLs and extensionless HTML pages
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Redirect direct homepage aliases, but not internal DirectoryIndex requests.
  RewriteCond %{THE_REQUEST} \s/+index(?:\.html)?[?\s]
  RewriteRule ^index(?:\.html)?$ https://www.suciconstructions.com/ [R=301,L]

  # Only redirect browser requests for HTML, avoiding internal rewrite loops.
  RewriteCond %{THE_REQUEST} \s/+[^?\s]+\.html[?\s]
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^(.+)\.html$ https://www.suciconstructions.com/$1 [R=301,L]

  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^www\.suciconstructions\.com$ [NC]
  RewriteRule ^(.*)$ https://www.suciconstructions.com/$1 [R=301,L]

  # Serve extensionless URLs using their existing HTML files.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^([^.]+)$ $1.html [L]
</IfModule>

# 2. Browser Caching
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|webp|avif|png|jpe?g|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# 3. Security Headers
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' https:; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: https:; font-src 'self' data: https:; connect-src 'self' https:; frame-src 'self' https:;"
</IfModule>
